{
  "name": "navidrome-upcoming-concerts-plugin",
  "author": "navidrome-upcoming-concerts-plugin contributors",
  "version": "0.4.1",
  "description": "Upcoming concerts from MusicBrainz for artists in your library, with an offline dashboard and calendar export. Community event coverage is limited.",
  "permissions": {
    "storage": {
      "reason": "Save resumable concert checks and the local HTML dashboard"
    },
    "scheduler": {
      "reason": "Refresh library daily and check concert pages in short steps"
    },
    "users": {
      "reason": "Read library artists as the user selected from granted access"
    },
    "library": {
      "reason": "Read assigned library metadata; reports stay in private plugin storage"
    },
    "subsonicapi": {
      "reason": "Read scoped artists, album credits and track credits internally"
    },
    "http": {
      "reason": "Fetch MusicBrainz artist and event metadata, and configured notifications or calendar updates.",
      "requiredHosts": [
        "musicbrainz.org",
        "ntfy.sh",
        "www.googleapis.com",
        "oauth2.googleapis.com",
        "caldav.icloud.com",
        "*.icloud.com",
        "app.ticketmaster.com",
        "api.seatgeek.com",
        "www.skiddle.com"
      ]
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "ahead_days": {
          "type": "integer",
          "title": "Days ahead",
          "default": 90,
          "minimum": 1,
          "maximum": 730
        },
        "past_days": {
          "type": "integer",
          "title": "Days back",
          "default": 0,
          "minimum": 0,
          "maximum": 365
        },
        "auto_match": {
          "type": "boolean",
          "title": "Match artists without IDs",
          "default": true,
          "description": "Use cautious exact-name matching. Add an override when an artist is ambiguous."
        },
        "artist_overrides": {
          "type": "string",
          "title": "Artist ID overrides",
          "default": "{}",
          "description": "JSON object mapping Navidrome artist IDs to MusicBrainz artist UUIDs."
        },
        "excluded_artists": {
          "type": "string",
          "title": "Excluded artist IDs",
          "default": "[]",
          "description": "JSON array of Navidrome artist IDs to skip."
        },
        "calendar_namespace": {
          "type": "string",
          "title": "Instance name",
          "default": "navidrome-upcoming-concerts-plugin",
          "description": "Use a unique name for each installation syncing to a shared calendar. Changing this leaves old events in place."
        },
        "ntfy_server": {
          "type": "string",
          "title": "ntfy server",
          "default": "https://ntfy.sh"
        },
        "ntfy_topic": {
          "type": "string",
          "title": "Topic",
          "default": "",
          "description": "Subscribe to this exact topic in your ntfy app. Treat public topic names as access secrets."
        },
        "ntfy_access_token": {
          "type": "string",
          "title": "ntfy access token",
          "default": ""
        },
        "ntfy_notify_initial": {
          "type": "boolean",
          "title": "Notify about existing concerts",
          "default": false,
          "description": "Include the initial backlog when Newly found concerts is selected. Otherwise the first scan is silent."
        },
        "calendar_provider": {
          "type": "string",
          "title": "Calendar service",
          "enum": [
            "none",
            "caldav",
            "google"
          ],
          "default": "none",
          "description": "Optional. Select none to disable remote calendar sync; local calendar export still works."
        },
        "caldav_calendar_url": {
          "type": "string",
          "title": "Calendar collection URL",
          "default": "",
          "description": "Full writable HTTPS calendar URL, not the account discovery URL."
        },
        "caldav_username": {
          "type": "string",
          "title": "CalDAV username",
          "default": ""
        },
        "caldav_app_password": {
          "type": "string",
          "title": "CalDAV app password",
          "default": ""
        },
        "google_calendar_id": {
          "type": "string",
          "title": "Calendar ID",
          "default": "",
          "description": "Use the ID of a dedicated writable calendar, not its sharing URL."
        },
        "google_client_id": {
          "type": "string",
          "title": "OAuth client ID",
          "default": "",
          "description": "Desktop OAuth client ID from your Google project."
        },
        "google_client_secret": {
          "type": "string",
          "title": "OAuth client secret",
          "default": "",
          "description": "Keep this private. Use the local authorization helper to obtain credentials."
        },
        "google_refresh_token": {
          "type": "string",
          "title": "OAuth refresh token",
          "default": "",
          "description": "Obtained using scripts/google_authorize.py. Never included in HTML or calendar files."
        },
        "manual_refresh": {
          "type": "boolean",
          "title": "Refresh concerts",
          "default": false,
          "description": "Change either way and Save to request a new check. The switch position is not an enabled/disabled state."
        },
        "exclude_uncredited": {
          "type": "boolean",
          "title": "Exclude artists without directly credited music",
          "default": false,
          "description": "Skip artists with no album or track credited to their own name in the selected libraries."
        },
        "dashboard_theme": {
          "type": "string",
          "title": "Dashboard theme",
          "enum": [
            "bright",
            "dark",
            "black"
          ],
          "default": "dark",
          "description": "Changes only the generated HTML colors. Refresh or copy the report after saving."
        },
        "ntfy_enabled": {
          "type": "boolean",
          "title": "Enable ntfy notifications",
          "default": false,
          "description": "Turn alerts on or off without clearing your topic or credentials."
        },
        "ntfy_notify_new": {
          "type": "boolean",
          "title": "Newly found concerts",
          "default": true,
          "description": "Notify when a concert first appears in your selected report window."
        },
        "ntfy_notify_updates": {
          "type": "boolean",
          "title": "Changed concert details",
          "default": true,
          "description": "Notify when a known concert changes its date, title or other reported details."
        },
        "ntfy_notify_concert_day": {
          "type": "boolean",
          "title": "Concert-day reminders",
          "default": false,
          "description": "Notify once per concert date, in UTC. Requires the plugin to run on that day."
        },
        "ticketmaster_enabled": {
          "type": "boolean",
          "title": "Enable Ticketmaster",
          "default": false
        },
        "ticketmaster_api_key": {
          "type": "string",
          "title": "Ticketmaster developer API key",
          "default": ""
        },
        "ticketmaster_daily_budget": {
          "type": "integer",
          "title": "Maximum Ticketmaster requests per UTC day",
          "minimum": 1,
          "maximum": 4500,
          "default": 4000
        },
        "ticketmaster_artist_overrides": {
          "type": "string",
          "title": "Ticketmaster artist mappings (JSON)",
          "default": "{}",
          "description": "Map Navidrome artist IDs to Ticketmaster attraction IDs. Name-only candidates need an explicit mapping."
        },
        "deduplicate_concerts": {
          "type": "boolean",
          "title": "Deduplicate concerts across sources",
          "default": true,
          "description": "Merge unambiguous matching concerts and keep every source link. Different show times and ambiguous matches stay separate."
        },
        "seatgeek_enabled": {
          "type": "boolean",
          "title": "Enable SeatGeek",
          "default": false
        },
        "seatgeek_client_id": {
          "type": "string",
          "title": "SeatGeek client ID (API key)",
          "default": ""
        },
        "seatgeek_client_secret": {
          "type": "string",
          "title": "SeatGeek client secret (optional)",
          "default": ""
        },
        "seatgeek_daily_budget": {
          "type": "integer",
          "title": "SeatGeek local daily request budget",
          "minimum": 1,
          "maximum": 4500,
          "default": 1000
        },
        "seatgeek_artist_overrides": {
          "type": "string",
          "title": "SeatGeek artist mappings (JSON)",
          "default": "{}",
          "description": "Map Navidrome artist IDs to positive numeric SeatGeek performer IDs, stored as strings."
        },
        "skiddle_enabled": {
          "type": "boolean",
          "title": "Enable Skiddle",
          "default": false
        },
        "skiddle_api_key": {
          "type": "string",
          "title": "Skiddle API key",
          "default": ""
        },
        "skiddle_daily_budget": {
          "type": "integer",
          "title": "Skiddle local daily request budget",
          "minimum": 1,
          "maximum": 4500,
          "default": 500
        },
        "skiddle_artist_overrides": {
          "type": "string",
          "title": "Skiddle artist mappings (JSON)",
          "default": "{}",
          "description": "Map Navidrome artist IDs to positive numeric Skiddle artist IDs, stored as strings."
        },
        "provider_auto_match": {
          "type": "boolean",
          "title": "Automatically match a single exact-name artist",
          "default": true,
          "description": "Use a unique exact-name candidate only after a complete search. Names can still refer to different artists; manual mappings override this heuristic. Ambiguous or truncated searches remain unresolved."
        }
      }
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Info",
          "elements": [
            {
              "type": "Label",
              "text": "Find upcoming and recent concerts from your library. Checks refresh daily and resume after restarts."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "Open upcoming-concerts.html from plugin storage in a browser. Refresh or copy a new version to see updates; MusicBrainz links need internet."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "General controls appearance and library filters; Integrations contains alerts and calendars. Keep working JSON files private."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Control",
              "scope": "#/properties/manual_refresh",
              "options": {
                "toggle": true
              }
            }
          ]
        },
        {
          "type": "Categorization",
          "label": "Plugin settings",
          "elements": [
            {
              "type": "Category",
              "label": "General",
              "elements": [
                {
                  "type": "Group",
                  "label": "Date window",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/ahead_days"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/past_days"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Appearance",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Choose Bright, Dark or Black for the HTML report. This changes colors only; your concert filters and calendar stay the same."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/dashboard_theme"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Automatic matching",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "MusicBrainz IDs in your music tags are the most reliable match. Automatic matching is a cautious fallback when tags have no ID."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/auto_match"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Exclusions",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/exclude_uncredited"
                    },
                    {
                      "type": "Label",
                      "text": "Keeps artists with at least one album or track credited to their own name. A split collaboration credit alone does not count."
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            },
            {
              "type": "Category",
              "label": "Concerts",
              "elements": [
                {
                  "type": "Group",
                  "label": "Concert formats",
                  "elements": []
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Standard and special concerts",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Choose concert formats above. For concerts with secondary tags, any selected tag below is enough to include the concert."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Spoken and other recordings",
                  "elements": []
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            },
            {
              "type": "Category",
              "label": "Integrations",
              "elements": [
                {
                  "type": "Group",
                  "label": "ntfy alerts",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Enable ntfy, enter a server and topic, and subscribe to that topic in your ntfy app. Switching alerts off keeps your settings; all alerts follow your General and Concerts filters."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_enabled",
                      "options": {
                        "toggle": true
                      }
                    },
                    {
                      "type": "Label",
                      "text": "Use an unguessable topic or a server with restricted read access. Anyone who can read a public topic can see its alerts."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_server"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_topic"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_access_token",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Label",
                      "text": "Choose what to receive. Concert-day reminders use UTC and require a full date; missed days are not replayed."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_new"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_updates"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_concert_day"
                    },
                    {
                      "type": "Label",
                      "text": "The first scan is silent unless you include existing concerts below. Re-enabling a notification category does not replay changes already skipped."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_initial"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Calendar destination",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Local calendar: use Save or share calendar in the HTML, or import music-concerts.ics. Imports are snapshots; select CalDAV or Google for automatic updates to a dedicated calendar."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Select none to stop remote sync; existing remote events stay in place and local export still works. Keep the same instance name and granted user when upgrading to preserve event identities."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/calendar_provider"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/calendar_namespace"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "CalDAV credentials",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Create a dedicated concerts calendar. Enter its full HTTPS collection URL and your provider\u2019s app credentials. An account/discovery URL will not work; redirects are not followed."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_calendar_url"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_username"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_app_password",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "caldav"
                      }
                    }
                  }
                },
                {
                  "type": "Label",
                  "text": "\u00a0",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "caldav"
                      }
                    }
                  }
                },
                {
                  "type": "Group",
                  "label": "Google Calendar credentials",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Create a dedicated Google calendar and copy its Calendar ID. In Google Cloud, enable Calendar API and create an OAuth Desktop client."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Run scripts/google_authorize.py with --client-json client.json --output google-oauth.json on your computer. Authorize the calendar account, then copy the saved credentials below."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "OAuth apps in Testing mode may need periodic reauthorization."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_calendar_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_secret",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_refresh_token",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
                },
                {
                  "type": "Label",
                  "text": "\u00a0",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "Category",
              "label": "Concert providers",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/deduplicate_concerts"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/provider_auto_match"
                },
                {
                  "type": "Group",
                  "label": "Ticketmaster Discovery",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Use your own free developer key. Local request budgets survive restarts, manual refreshes and library changes. Other applications using the same key share the provider quota."
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ticketmaster_enabled"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ticketmaster_api_key",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ticketmaster_daily_budget"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ticketmaster_artist_overrides"
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "SeatGeek",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Use your own client ID (API key); the client secret is optional. The local budget is a conservative configurable cap, not a published provider allowance. Configure it within your account limits."
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/seatgeek_enabled"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/seatgeek_client_id",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/seatgeek_client_secret",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/seatgeek_daily_budget"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/seatgeek_artist_overrides"
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "Skiddle",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "For personal, non-commercial use under Skiddle API terms. Reports retain Skiddle attribution, brand logo and original event links. Use one private key and configure this local budget within your account allowance. After client errors or three failed attempts, fix configuration and use manual refresh."
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/skiddle_enabled"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/skiddle_api_key",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/skiddle_daily_budget"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/skiddle_artist_overrides"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Category",
              "label": "Matching",
              "elements": [
                {
                  "type": "Group",
                  "label": "Fix an artist match",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Copy the Navidrome artist ID from the report\u2019s attention section. Find the correct MusicBrainz artist and copy the UUID at the end of its artist-page URL, not a concert ID."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Enter a JSON mapping from Navidrome ID to MusicBrainz artist UUID. Example:"
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "{\"artist-id-from-report\":\"11111111-2222-4333-8444-555555555555\"}"
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_overrides",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Exclude artists",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Enter Navidrome IDs as a JSON array, for example [\"artist-id-from-report\"]. Save changes to apply matching and exclusion settings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/excluded_artists",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            }
          ]
        },
        {
          "type": "Group",
          "label": "Library access",
          "elements": [
            {
              "type": "Label",
              "text": "Grant exactly one user in Users Permission and select the intended libraries in Library Permission. Turn off Allow all users when more than one account exists. Library write access is not needed."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "MusicBrainz lookups need no personal account or email; requests use the plugin\u2019s project identification."
            }
          ]
        }
      ]
    }
  }
}
